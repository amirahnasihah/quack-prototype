{
  "name": "standard — block secrets in push (org-wide)",
  "target": "push",
  "enforcement": "active",
  "conditions": {
    "repository_name": {
      "include": ["~ALL"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "file_path_restriction",
      "parameters": {
        "restricted_file_paths": [
          ".env",
          ".env.*",
          "**/.env",
          "**/.env.*",
          "**/*.pem",
          "**/*.key",
          "**/credentials.json",
          "**/service-account*.json",
          "**/firebase-adminsdk*.json"
        ]
      }
    },
    {
      "type": "file_extension_restriction",
      "parameters": {
        "restricted_file_extensions": [".pem", ".key", ".p12", ".pfx"]
      }
    }
  ],
  "bypass_actors": [
    {
      "actor_id": null,
      "actor_type": "OrganizationAdmin",
      "bypass_mode": "always"
    }
  ]
}
